DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inzet?schema=public"
# Docker derives its DATABASE_URL from these values, including URL encoding.
# Production: replace the development password below with a strong password.
# Use single quotes around passwords containing $ so Compose keeps them literal.
POSTGRES_DB="inzet"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
# Signs the session and CSRF cookies. Required in production, at least 32 characters.
# Generate one with: openssl rand -hex 32
# Rotating it logs every user out (use this after an incident).
SESSION_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MAIL_FROM="Inzet <info@frii.nl>"
MAIL_ENVELOPE_FROM="info@frii.nl"
MAIL_MESSAGE_ID_DOMAIN="frii.nl"
SENDMAIL_PATH="/usr/sbin/sendmail"
SENDMAIL_IN_DEV="false"
SMTPHOST="mail:25"
# Extern relay voor de mail-container, nodig omdat frii.nl's eigen DMARC-beleid
# (p=reject) direct verzenden vanaf de VPS zelf laat weigeren door Gmail e.d.
MAIL_RELAY_HOST="linux2210.webawere.nl"
MAIL_RELAY_PORT="465"
MAIL_RELAY_USERNAME="info@frii.nl"
MAIL_RELAY_PASSWORD=""
