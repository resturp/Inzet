[Unit]
Description=Inzet vrijwilligersportaal
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__INZET_ROOT__
ExecStartPre=/usr/bin/docker compose -f __INZET_ROOT__/docker-compose.yml -f __INZET_ROOT__/docker-compose.prod.yml config -q
ExecStart=/bin/bash __INZET_ROOT__/scripts/compose-prod-up.sh
ExecReload=/bin/bash __INZET_ROOT__/scripts/compose-prod-up.sh
ExecStop=/usr/bin/docker compose -f __INZET_ROOT__/docker-compose.yml -f __INZET_ROOT__/docker-compose.prod.yml stop
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
